# Database (port 5498 to avoid conflicts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5498/anvara_sponsorships

# Backend (port 4291)
BACKEND_PORT=4291

# Frontend (port 3847)
NEXT_PUBLIC_API_URL=http://localhost:4291

# Google Analytics 4 (optional – set to enable tracking)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Log analytics events to browser console (for verifying conversion tracking)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# Force A/B test variant for CTA button (A or B) for verification
# NEXT_PUBLIC_AB_DEBUG_CTA_BUTTON_TEXT=A

# Better Auth
BETTER_AUTH_SECRET=use-openssl-rand-hex-32-to-generate-this
BETTER_AUTH_URL=http://localhost:3847
